{
  "data_root": "data/generator_sources",
  "use_sources": [
    "real",
    "syn_amt_A",
    "syn_amt_B",
    "syn_mt"
  ],
  "real_to_syn_ratio": 1.0,
  "in_channels": 4,
  "input_length": 2048,
  "patch_size": 8,
  "hidden_dim": 384,
  "depth": 12,
  "num_heads": 6,
  "mlp_ratio": 4.0,
  "num_timesteps": 1000,
  "beta_schedule": "linear",
  "batch_size": 128,
  "lr": 0.0001,
  "weight_decay": 0.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "grad_clip": 1.0,
  "num_steps": 200000,
  "warmup_steps": 1000,
  "ema_decay": 0.9999,
  "mixed_precision": "fp16",
  "num_workers": 4,
  "log_interval": 50,
  "sample_interval": 5000,
  "ckpt_interval": 10000,
  "n_samples_to_generate": 8,
  "out_dir": "outputs/geoamt_dit",
  "resume_from": null,
  "seed": 42
}
