{
  "data_root": "./noise_data",
  "synthetic_root": "./noise_data/Synthetic-Norm",
  "include_real": true,
  "include_synthetic": true,
  "fixed_length": null,
  "target_length": 2048,
  "train_lengths": null,
  "data_normalize": "rms",
  "random_embed": true,
  "flip_prob": 0.5,
  "sign_flip_prob": 0.5,
  "balance_type": true,
  "balance_source": true,
  "real_weight": 0.5,
  "synthetic_weight": 1.0,
  "in_channels": 1,
  "input_length": 2048,
  "patch_size": 8,
  "hidden_dim": 384,
  "depth": 12,
  "num_heads": 6,
  "mlp_ratio": 4.0,
  "num_noise_types": 10,
  "condition_on_length": true,
  "condition_on_source": false,
  "num_timesteps": 1000,
  "beta_schedule": "linear",
  "batch_size": 64,
  "lr": 5e-05,
  "weight_decay": 0.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "grad_clip": 1.0,
  "num_steps": 200000,
  "warmup_steps": 1000,
  "ema_decay": 0.9999,
  "mixed_precision": "none",
  "num_workers": 4,
  "log_interval": 50,
  "sample_interval": 5000,
  "ckpt_interval": 10000,
  "n_samples_to_generate": 20,
  "sample_lengths": [
    100,
    300,
    750,
    1500,
    2048
  ],
  "sample_ddim_steps": 50,
  "out_dir": "./outputs/multilength",
  "resume_from": null,
  "seed": 42
}
